# Copia este archivo a .env y ajusta los valores

# Cadena de conexion a tu PostgreSQL local o remoto
DATABASE_URL=postgresql://usuario:password@localhost:5432/migracion_prism?schema=public

# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Upstash Redis (tiempo real + límite de intentos de login). En Vercel suelen
# venir del marketplace. En local, usa las credenciales REST de tu base Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Conexión TCP usada por el canal SSE (/api/events)
REDIS_URL=

# Contraseñas iniciales del seed (prisma/seed.ts). Si no las defines, el seed
# genera una aleatoria y la imprime una sola vez. NUNCA las dejes escritas en
# el código ni las subas al repositorio.
SEED_ADMIN_PASSWORD=
SEED_DEPARTMENT_PASSWORD=
