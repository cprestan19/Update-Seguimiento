// Modelo de datos - Control de Migracion RPro v9 -> Prism 2.2
// ASW Group

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Autenticacion y personal
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  USER
  MONITOR
}

enum PersonnelRole {
  TECNICO
  AUDITOR_TI
  AUDITOR_INVENTARIO
  COORDINADOR
  INFRAESTRUCTURA
}

model User {
  id                  String         @id @default(cuid())
  name                String
  username            String         @unique
  passwordHash        String
  role                Role           @default(USER)
  personnelRole       PersonnelRole?
  pais                String?
  isSuperAdmin        Boolean        @default(false)
  active              Boolean        @default(true)
  lastActiveAt        DateTime?
  lastActiveProjectId String?
  lastActiveProject   Project?       @relation("UserLastActiveProject", fields: [lastActiveProjectId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  storesAsTecnico     Store[] @relation("Tecnico")
  storesAsAuditorTI   Store[] @relation("AuditorTI")
  storesAsAuditorInv  Store[] @relation("AuditorInv")

  incidentsCreated    Incident[]            @relation("IncidentCreatedBy")
  incidentsResolved   Incident[]            @relation("IncidentResolvedBy")
  checklistCompleted  StoreChecklistItem[]  @relation("ChecklistCompletedBy")
  auditLogs           AuditLog[]

  seguimientosAsignados SeguimientoItem[]   @relation("SeguimientoResponsable")
  seguimientosCreados   SeguimientoItem[]   @relation("SeguimientoCreatedBy")

  projectMemberships    ProjectMember[]
  projectsCreated       Project[]           @relation("ProjectCreatedBy")

  requirementsAsLider                  Requirement[]         @relation("RequirementLider")
  requirementsAsResponsableTecnico     Requirement[]         @relation("RequirementResponsableTecnico")
  requirementsAsResponsableDependencia Requirement[]         @relation("RequirementResponsableDependencia")
  requirementsCreated                  Requirement[]         @relation("RequirementCreatedBy")
  requirementActivities                RequirementActivity[] @relation("RequirementActivityUser")

  guardianTargetsCreated GuardianTarget[] @relation("GuardianTargetCreatedBy")
  guardianScansStarted   GuardianScan[]   @relation("GuardianScanStartedBy")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Departamentos: unidad organizativa duena de uno o mas Proyectos. Se entra a
// la seccion de proyectos de un Departamento con una contrasena de
// administrador compartida (no ligada a un usuario individual).
// ---------------------------------------------------------------------------

model Department {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  adminPasswordHash String
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  projects          Project[]

  @@map("departments")
}

// ---------------------------------------------------------------------------
// Proyectos (multi-tenant): cada Project es un workspace aislado; un User
// puede pertenecer a varios via ProjectMember, con rol propio por proyecto.
// Cada Project pertenece a un Department.
// ---------------------------------------------------------------------------

model Project {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  active       Boolean  @default(true)
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  createdById  String?
  createdBy    User?    @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members             ProjectMember[]
  stores              Store[]
  checklistCategories ChecklistCategory[]
  seguimientos        SeguimientoItem[]
  auditLogs           AuditLog[]
  usersLastActiveHere User[]              @relation("UserLastActiveProject")
  requirements        Requirement[]
  guardianTargets     GuardianTarget[]

  @@index([departmentId])
  @@map("projects")
}

model ProjectMember {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role           @default(USER)
  personnelRole PersonnelRole?
  pais          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// ---------------------------------------------------------------------------
// Tiendas y estado de migracion
// ---------------------------------------------------------------------------

enum EstadoMigracion {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CON_INCIDENCIA
}

model Store {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pais              String
  region            String
  tienda            String
  horario           String // texto original del Excel, ej: "4:00AM"
  minutosDia        Int // horario normalizado a minutos desde medianoche, para ordenar/graficar
  estado            EstadoMigracion @default(PENDIENTE)

  tecnicoId         String?
  tecnico           User?           @relation("Tecnico", fields: [tecnicoId], references: [id])
  auditorTIId       String?
  auditorTI         User?           @relation("AuditorTI", fields: [auditorTIId], references: [id])
  auditorInvId      String?
  auditorInv        User?           @relation("AuditorInv", fields: [auditorInvId], references: [id])

  tiempoEstimadoMin Int             @default(45)
  inicioReal        DateTime?
  finReal           DateTime?
  duracionRealMin   Int?

  inventarioInicial Int?
  inventarioFinal   Int?
  costoInicial      Float?
  costoFinal        Float?

  checklist         StoreChecklistItem[]
  incidents         Incident[]
  seguimientos      SeguimientoItem[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([pais])
  @@index([estado])
  @@index([projectId])
  @@map("stores")
}

// ---------------------------------------------------------------------------
// Checklist: definicion (catalogo) + estado por tienda
// ---------------------------------------------------------------------------

model ChecklistCategory {
  id        String             @id @default(cuid())
  projectId String
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nombre    String
  orden     Int
  items     ChecklistItemDef[]

  @@index([projectId])
  @@map("checklist_categories")
}

model ChecklistItemDef {
  id          String              @id @default(cuid())
  categoryId  String
  category    ChecklistCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nombre      String
  orden       Int
  storeItems  StoreChecklistItem[]

  @@map("checklist_item_defs")
}

model StoreChecklistItem {
  id              String            @id @default(cuid())
  storeId         String
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  itemDefId       String
  itemDef         ChecklistItemDef  @relation(fields: [itemDefId], references: [id], onDelete: Cascade)
  completado      Boolean           @default(false)
  completadoPorId String?
  completadoPor   User?             @relation("ChecklistCompletedBy", fields: [completadoPorId], references: [id])
  completadoEn    DateTime?
  noAplica        Boolean           @default(false)

  @@unique([storeId, itemDefId])
  @@map("store_checklist_items")
}

// ---------------------------------------------------------------------------
// Incidencias
// ---------------------------------------------------------------------------

enum Severidad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

model Incident {
  id             String     @id @default(cuid())
  storeId        String
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  severidad      Severidad  @default(MEDIA)
  descripcion    String
  resuelta       Boolean    @default(false)
  createdById    String?
  createdBy      User?      @relation("IncidentCreatedBy", fields: [createdById], references: [id])
  resolvedById   String?
  resolvedBy     User?      @relation("IncidentResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  createdAt      DateTime   @default(now())

  @@map("incidents")
}

// ---------------------------------------------------------------------------
// Seguimiento post-migracion (correcciones pendientes tras el paso a Prism)
// ---------------------------------------------------------------------------

enum EstadoSeguimiento {
  PENDIENTE
  EN_SEGUIMIENTO
  COMPLETADO
}

model SeguimientoItem {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  region         String // texto libre: no siempre coincide 1:1 con Store.region (ej. "Todos", "Honduras T")
  tienda         String? // texto libre: tienda puntual, varias tiendas, o alcance ("Todos")
  storeId        String?
  store          Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  descripcion    String
  estado         EstadoSeguimiento @default(PENDIENTE)

  responsableId  String?
  responsable    User?             @relation("SeguimientoResponsable", fields: [responsableId], references: [id])

  createdById    String?
  createdBy      User?             @relation("SeguimientoCreatedBy", fields: [createdById], references: [id])

  completadoEn   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([region])
  @@index([estado])
  @@index([projectId])
  @@map("seguimiento_items")
}

// ---------------------------------------------------------------------------
// Auditoria (quien hizo que y cuando)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  accion    String // ej: "CHECKLIST_TOGGLE", "ASIGNACION", "INCIDENCIA_CREADA", "LOGIN"
  entidad   String? // ej: "Store:cly123..."
  detalle   String?
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Gestion de Requerimientos: modulo general de proyectos tecnologicos
// (desarrollo, infraestructura, redes, implementaciones, etc.), independiente
// de Store/Checklist/SeguimientoItem que siguen siendo especificos de la
// migracion RPro->Prism. Cada Requirement pertenece a un solo Project.
// ---------------------------------------------------------------------------

enum RequirementTipo {
  NUEVO_DESARROLLO
  MEJORA
  ACTUALIZACION
}

enum RequirementArea {
  DESARROLLO
  IMPLEMENTACION
  INFRAESTRUCTURA
  REDES
  SEGURIDAD
  INTEGRACION
  MIGRACION
  SOPORTE
  MANTENIMIENTO
  OTRO
}

enum RequirementPrioridad {
  CRITICA
  ALTA
  MEDIA
  BAJA
}

enum RequirementEstado {
  SOLICITUD
  ANALISIS
  APROBADO
  EN_DESARROLLO
  EN_IMPLEMENTACION
  EN_PRUEBAS
  EN_PAUSA
  IMPLEMENTADO
  CERRADO
  CANCELADO
}

enum RequirementImpacto {
  SIN_IMPACTO
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum RequirementAlcanceAfectados {
  USUARIO
  DEPARTAMENTO
  TIENDA
  PAIS
  REGION
  ORGANIZACION
}

enum RequirementRiesgo {
  BAJO
  MEDIO
  ALTO
}

enum RequirementActivityTipo {
  COMENTARIO
  ACTIVIDAD
  CREACION
  EDICION
  CAMBIO_ESTADO
  CAMBIO_RESPONSABLE
  CAMBIO_PRIORIDAD
  FECHA_MODIFICADA
  CIERRE
  ELIMINACION
}

model Requirement {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  numero    String // "REQ-2026-00001", unico dentro del proyecto (ver RequirementCounter)

  titulo              String
  descripcion         String // descripcion detallada del requerimiento, sin limite de longitud (TEXT)
  objetivo            String?
  alcance             String?
  fueraDeAlcance      String?
  criteriosAceptacion String?

  // Explicacion tecnica de COMO se realizara el cambio -- la llena el
  // responsable tecnico (o cualquier no-MONITOR), por separado y
  // normalmente despues de la solicitud inicial. Tambien sin limite (TEXT).
  explicacionTecnica String?

  // Solicitud: solicitante/gerente suelen ser personas de negocio que nunca
  // inician sesion en el sistema -> texto libre, no se crea un User falso.
  solicitadoPorNombre     String
  departamentoSolicitante String // depto de NEGOCIO que pide el cambio (no es el Department organizativo)
  gerenteDepartamento     String?

  // Lider de proyecto y responsable tecnico SI son miembros reales del
  // proyecto -> FK a User, validados con isProjectMember() al escribir.
  liderProyectoId      String?
  liderProyecto        User?   @relation("RequirementLider", fields: [liderProyectoId], references: [id], onDelete: SetNull)
  responsableTecnicoId String?
  responsableTecnico   User?   @relation("RequirementResponsableTecnico", fields: [responsableTecnicoId], references: [id], onDelete: SetNull)
  observaciones        String?

  fechaSolicitud       DateTime
  fechaEstimadaEntrega DateTime
  fechaRealEntrega     DateTime?

  tipo      RequirementTipo
  area      RequirementArea
  prioridad RequirementPrioridad
  estado    RequirementEstado    @default(SOLICITUD)
  impacto   RequirementImpacto   @default(SIN_IMPACTO)

  alcanceAfectados        RequirementAlcanceAfectados?
  alcanceAfectadosDetalle String? // ej. nombre de tienda/depto/usuario cuando alcanceAfectados lo requiere

  bloqueado                Boolean @default(false)
  motivoBloqueo            String?
  dependenciaExterna       Boolean @default(false)
  dependenciaInterna       Boolean @default(false)
  responsableDependenciaId String?
  responsableDependencia   User?   @relation("RequirementResponsableDependencia", fields: [responsableDependenciaId], references: [id], onDelete: SetNull)

  riesgo       RequirementRiesgo?
  motivoRiesgo String?

  camposArea     Json? // campos dinamicos segun 'area' (servidor/IP/VLAN, repositorio/modulo, etc.)
  implementacion Json? // ambiente, ventana de mantenimiento, plan de rollback, evidencia, dependencias tecnicas

  activo      Boolean   @default(true) // soft delete, nunca se borra fisicamente
  eliminadoEn DateTime?

  createdById String?
  createdBy   User?    @relation("RequirementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities RequirementActivity[]

  @@unique([projectId, numero])
  @@index([projectId])
  @@index([projectId, estado])
  @@map("requirements")
}

// Comentarios manuales Y eventos automaticos de historial en una sola tabla
// (creacion, cambio de estado/responsable/prioridad, cambio de fecha con
// motivo, cierre, eliminacion). 'metadata' guarda el antes/despues
// estructurado (ej. {fechaAnterior, fechaNueva, motivo}).
model RequirementActivity {
  id            String                  @id @default(cuid())
  requirementId String
  requirement   Requirement             @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  tipo          RequirementActivityTipo
  descripcion   String
  metadata      Json?
  userId        String?
  user          User?                   @relation("RequirementActivityUser", fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime                @default(now())

  @@index([requirementId])
  @@map("requirement_activities")
}

// Numeracion atomica por proyecto+año, independiente del id interno de Prisma.
model RequirementCounter {
  projectId String
  year      Int
  seq       Int    @default(0)

  @@id([projectId, year])
  @@map("requirement_counters")
}

// ===========================================================================
// GUARDIAN TOOLSIT: auditoría de seguridad / pentest de aplicativos.
//
// Un GuardianTarget es un objetivo a auditar (un repositorio de código o una
// URL de una app web/SaaS). Pertenece a un Project de ToolsIT (aislamiento
// multi-tenant). Antes de cualquier prueba que vaya más allá de leer la
// portada pública, un objetivo de tipo URL debe estar VERIFICADO (prueba de
// propiedad por DNS o archivo well-known) o tener una autorización firmada
// registrada — así Guardian solo audita sistemas que su dueño autorizó.
// ===========================================================================

enum GuardianTargetType {
  URL  // aplicación web / SaaS en vivo
  REPO // repositorio de código (análisis estático)
}

enum GuardianVerificationStatus {
  UNVERIFIED // no se puede probar más que la portada pública
  PENDING    // token emitido, esperando comprobación
  VERIFIED   // propiedad comprobada
  AUTHORIZED // sin verificación técnica, pero con autorización escrita registrada
}

enum GuardianScanProfile {
  SAFE // no intrusivo: cabeceras/TLS/cookies de la portada, análisis de código
  FULL // añade sondas de exposición y más rutas; requiere objetivo verificado/autorizado
}

enum GuardianScanType {
  URL_HEADERS   // cabeceras de seguridad, TLS, cookies
  URL_EXPOSURE  // archivos/rutas sensibles expuestos (.env, .git, backups)
  REPO_DEPS     // dependencias vulnerables (package.json / lockfile)
  REPO_SECRETS  // secretos hardcodeados
  REPO_SAST     // patrones de código inseguro
  REPO_CONFIG   // configuración insegura
}

enum GuardianScanStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum GuardianSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GuardianFindingStatus {
  OPEN
  CONFIRMED
  FALSE_POSITIVE
  FIXED
  ACCEPTED_RISK
}

model GuardianTarget {
  id          String             @id @default(cuid())
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        GuardianTargetType
  // URL base (type URL) o URL del repositorio (type REPO)
  url         String
  description String?

  // Propiedad / autorización
  verification       GuardianVerificationStatus @default(UNVERIFIED)
  verificationToken  String? // token que el dueño debe publicar (DNS TXT o /.well-known)
  verifiedAt         DateTime?
  authorizedByName   String? // quién firmó la autorización (cuando es AUTHORIZED)
  authorizationNote  String?
  // Lista blanca de rutas/subdominios permitidos y tope de peticiones por minuto
  allowedPaths       String[] @default([])
  rateLimitPerMin    Int      @default(60)

  createdById String?
  createdBy   User?    @relation("GuardianTargetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scans GuardianScan[]

  @@index([projectId])
  @@map("guardian_targets")
}

model GuardianScan {
  id         String             @id @default(cuid())
  targetId   String
  target     GuardianTarget     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  profile    GuardianScanProfile @default(SAFE)
  types      GuardianScanType[]
  status     GuardianScanStatus  @default(QUEUED)

  startedAt  DateTime?
  finishedAt DateTime?
  error      String?

  // Conteos rápidos para listar sin cargar todos los hallazgos
  countCritical Int @default(0)
  countHigh     Int @default(0)
  countMedium   Int @default(0)
  countLow      Int @default(0)
  countInfo     Int @default(0)

  startedById String?
  startedBy   User?    @relation("GuardianScanStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  findings GuardianFinding[]

  @@index([targetId])
  @@map("guardian_scans")
}

model GuardianFinding {
  id       String           @id @default(cuid())
  scanId   String
  scan     GuardianScan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  type     GuardianScanType
  severity GuardianSeverity
  status   GuardianFindingStatus @default(OPEN)

  title       String
  description String
  // Dónde: URL, archivo:línea, nombre de dependencia, etc.
  location    String?
  // Evidencia textual (recortada / saneada, nunca el secreto completo)
  evidence    String?
  recommendation String?
  // Referencias: CWE, OWASP, advisory
  cwe   String?
  owasp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scanId])
  @@map("guardian_findings")
}
